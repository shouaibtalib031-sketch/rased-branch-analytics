NODE_ENV=production
HOST=0.0.0.0
PORT=8080
TRUST_PROXY=true
JWT_SECRET=replace-with-a-cryptographically-random-secret-at-least-32-characters
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
SEED_DEMO_DATA=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Railway: do not type a fixed PostgreSQL URL manually.
# Set DATABASE_URL in the web service as a reference to the Railway Postgres service,
# for example: ${{Postgres.DATABASE_URL}} or use Railway's "Add Reference" UI.
DATABASE_URL=
MAX_UPLOAD_MB=25
UPLOAD_DIR=/var/lib/rased/uploads
OUTPUT_PDF_DIR=/var/lib/rased/reports
